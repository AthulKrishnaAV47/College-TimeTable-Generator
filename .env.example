# Copy to .env.local for development. Use DIFFERENT projects/keys in production.
APP_URL=http://localhost:3000
SUPABASE_URL=https://YOUR-DEVELOPMENT-PROJECT.supabase.co
# Public anon/publishable key; still kept server-side. NEVER use service_role here.
SUPABASE_ANON_KEY=
# Required in production; isolated per environment. Development has an in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional, redacted errors only. Public DSN is an ingestion endpoint, not a secret.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Optional source map upload (CI/Vercel secrets only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
